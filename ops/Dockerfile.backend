# syntax=docker/dockerfile:1.4
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app
COPY pom.xml .
COPY domain domain
COPY repository repository
COPY matchmaking matchmaking
COPY ai ai
COPY controller controller
# Persistent cache for ~/.m2 across builds: dependencies stay downloaded
# even when source files change. Cuts a clean build's mvn step from
# minutes (re-downloading every Spring/Lombok/etc. jar) to seconds.
RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -B -N install \
 && mvn -B -pl domain,repository,matchmaking,ai install -DskipTests \
 && mvn -B -pl controller package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /app/controller/target/*.jar app.jar
COPY --from=build /app/ai/src/main/resources/bin/fairy-stockfish /app/fairy-stockfish
RUN chmod +x /app/fairy-stockfish
ENV STOCKFISH_PATH=/app/fairy-stockfish
EXPOSE 9000
ENTRYPOINT ["java", "-jar", "app.jar"]
